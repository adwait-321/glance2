# Get keys at https://aistudio.google.com/apikey
# Put as many as you like, comma-separated. Glance rotates through them and sidelines any key that hits a 429.
# NOTE: Gemini rate limits are per Google Cloud PROJECT, not per key. Keys created inside the same project share
# one quota, so make each key in a different project (AI Studio -> Create API key -> "Create API key in new project").
GEMINI_API_KEYS=key_one,key_two,key_three
# (the old single GEMINI_API_KEY=... still works and is merged into the list)

# Model strategy (v1beta endpoint). Each model has its own quota: if every key is out of quota on the primary,
# the fallback model is tried with the same keys. Also falls back on 503/500/404.
GLANCE_PRIMARY_MODEL=gemini-3-flash-preview
# One id or a comma-separated list, tried in order. gemini-2.5-flash is retired/retiring (404), don't use it.
GLANCE_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.5-flash

# MongoDB — local server or an Atlas URI (mongodb+srv://user:pass@cluster.xxxxx.mongodb.net)
# If it can't connect, Glance keeps working and stores history in a local file instead.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=glance

# User profile (defaults to your OS username)
# GLANCE_USER=adwait
# GLANCE_DISPLAY_NAME=Adwait

# Global hotkey
GLANCE_HOTKEY=CommandOrControl+Shift+G

# 1 = save each screenshot + mapping JSON to the app's userData/debug folder
GLANCE_DEBUG=0

# 0 = turn off the close-up change check around the pointer (auto-advance for small changes)
GLANCE_FOCUS=1

# 1 = no API calls; returns canned steps pointing at screen centre (for testing the UI/loop)
GLANCE_MOCK=0
